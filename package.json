{
  "name": "codepulse",
  "version": "1.0.0",
  "description": "CODE PULSE - Intelligent Emergency Response Coordination Platform",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "dev:server": "node server/index.js",
    "dev:client": "vite",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
